# ===== Telegram =====
# Bot token from @BotFather. Empty -> notifications are printed to stdout and the bot does not start.
BOT_TOKEN=
# Comma-separated admin user ids (only they can use the bot). Required when BOT_TOKEN is set.
ADMIN_IDS=
# Where alerts go (comma-separated chat ids). Empty -> ADMIN_IDS.
ALERT_CHAT_IDS=

# ===== Data source =====
# auto | getgems | tonapi. auto = getgems when GETGEMS_API_KEY is set, otherwise tonapi
# (free: listings plus a sampled sales history from on-chain NftPurchase events; no bids).
DATA_SOURCE=auto
# Getgems Public API key (https://getgems.io/public-api, paid). Sent as-is in the Authorization header.
GETGEMS_API_KEY=
GETGEMS_API_BASE=https://api.getgems.io/public-api
# Also read off-chain gift listings (/v1/nfts/offchain/on-sale). Not verified.
GETGEMS_INCLUDE_OFFCHAIN=false
# TonAPI key (optional; without a key about 1 rps and at most 100 items per page).
TONAPI_KEY=
TONAPI_BASE=https://tonapi.io/v2
# How many collection items to scan per cycle via TonAPI (TonAPI cannot filter "on sale only").
TONAPI_SCAN_ITEMS=1000
# Free sales history (no Getgems key): per watched collection, read the on-chain NftPurchase
# history of up to this many items per refresh (listed items first, then a rotating slice of the
# rest). At the anonymous ~1 rps that is about one second per item.
TONAPI_HISTORY_ITEMS=60
# Do not re-read an item's history for this many minutes (per-item cache).
TONAPI_HISTORY_TTL_MIN=360
# Minimum interval between API requests, ms (Getgems: 400 requests / 5 minutes).
REQUEST_MIN_INTERVAL_MS=800

# ===== What to watch =====
# Comma-separated collections: address (EQ.../UQ.../0:...) or gift collection name (needs Getgems).
# Added to the DB on start; later use /watch.
WATCH_COLLECTIONS=
# Pages of 100 listings per collection per cycle (Getgems, sorted by price).
LISTING_PAGES=1
# Pause between cycles, seconds.
POLL_INTERVAL_SEC=60
# Do not repeat an alert for the same NFT at the same price for N minutes.
ALERT_COOLDOWN_MIN=360

# ===== Cheap gifts =====
# Alert when price <= X TON (0 = off).
CHEAP_MAX_PRICE_TON=0
# Alert when X% below the floor (floor = next listing, i.e. the 2nd cheapest for the cheapest one).
CHEAP_BELOW_FLOOR_PCT=15

# ===== Undervalued NFTs (fair value from past sales) =====
# Alert when X% below fair value.
UNDERVALUED_DISCOUNT_PCT=25
# Comparison levels from fine to coarse. Combinations allowed: model+backdrop,model,backdrop,symbol,collection
VALUATION_LEVELS=model,backdrop,symbol,collection
# Use the last N comparable sales.
COMPARABLES_N=20
# Minimum sales per level, otherwise fall back to a coarser level (the alert says so).
MIN_COMPARABLES=3
# Sales history window, days.
LOOKBACK_DAYS=30
# Time-weighted median (recent sales weigh more).
TIME_WEIGHTED=true
# Weight half-life, days.
HALF_LIFE_DAYS=7
# How often to refresh a collection's sales cache, minutes.
SALES_REFRESH_MIN=30
# Max pages (of 100) of sales history per refresh.
SALES_MAX_PAGES=5

# ===== Honest price: clean comps and confidence =====
# Drop sales that are not real market prices: Getgems-flagged, round trips, repeated wallet pairs.
WASH_FILTER=true
# A sale back to a previous seller of the same NFT within N days is a round trip (both sales ignored).
WASH_ROUNDTRIP_DAYS=30
# The same two wallets trading N+ times in the window (any NFT) -> all those sales ignored.
WASH_PAIR_MIN_REPEATS=2
# Per-level outliers: drop prices outside median ± K x 1.4826 x MAD (only with 5+ comps). 0 = off.
OUTLIER_MAD_K=3
# Confidence A: model-level comps, at least N of them, spread (IQR/median) at most X.
CONF_A_MIN_COMPS=8
CONF_A_MAX_SPREAD=0.25
# Confidence B: at least MIN_COMPARABLES comps and spread at most X. Everything else is C.
CONF_B_MAX_SPREAD=0.5
# Autobuy only acts on this confidence or better: A | B.
AUTOBUY_MIN_CONFIDENCE=B
# Let autobuy act on alerts without a sales-based price (floor only). Default: they count as C.
AUTOBUY_ALLOW_FLOOR_ONLY=false

# ===== Real profit card (all prices are net: fees, royalty and gas included) =====
# Gas actually consumed by a buy (the BUY_GAS_TON buffer above it is returned by the sale contract).
NETWORK_COST_TON=0.1
# Gas to list and sell later.
SELL_COST_TON=0.1
# Fallback fee and royalty, % of the price, when listings do not expose them.
# TODO(verify): taken from the listings' own sale contracts when present; defaults are estimates.
MARKET_FEE_PCT_FALLBACK=5
ROYALTY_PCT_FALLBACK=5
# Currency label in messages (configurable in case TON is relabelled).
CURRENCY_LABEL=TON
# Fiat line on cards, from TonAPI /v2/rates (comma-separated: usd,eur,rub). Empty = off.
FIAT_CURRENCIES=usd
RATES_TTL_MIN=10
# Open bids (Getgems offers): looked up only for alerted listings, cached, with a call budget.
OFFERS_ENABLED=true
OFFERS_TTL_MIN=5
OFFERS_MAX_CALLS_PER_CYCLE=10
# A bid that pays at least this much over the all-in cost marks the card EXIT-BACKED.
BID_COVER_MIN_EDGE_TON=0.3
# Alerts that lose money after fees: silent (no sound) | drop (log only) | push.
NEGATIVE_EDGE_ALERTS=silent
# Liquidity badges by expected days to resell: fast <= X, normal <= Y, slow <= Z, else illiquid.
LIQ_FAST_DAYS=3
LIQ_SLOW_DAYS=14
LIQ_ILLIQUID_DAYS=30
OFFCHAIN_NOTE=Off-chain gift: it stays in your Getgems account; withdrawing it to Telegram costs a fee.
TELEMINT_NOTE=Telemint sale (Fragment-style item).

# ===== Safe to buy? (traffic light; autobuy only buys green) =====
# "Unusually cheap" warning when price < X% of fair value.
RISK_TOO_GOOD_PCT=35
# Warning check ids autobuy may accept anyway (comma-separated), e.g. sale_type,seller_history. Empty = green only.
AUTOBUY_ALLOW_WARN=
# Cache for the Getgems status endpoint (seconds) and seller trading info (minutes).
RISK_STATUS_TTL_SEC=60
SELLER_INFO_TTL_MIN=60
# Extra gift collection addresses to treat as official (comma-separated).
GIFT_COLLECTION_ALLOWLIST=

# ===== What are my gifts worth? (portfolio) =====
# Max collections whose sales are refreshed per /mygifts request.
PORTFOLIO_MAX_COLLECTIONS=15
# Local hour for the daily snapshot of tracked profiles/wallets (-1 = off).
PORTFOLIO_DAILY_HOUR=10
PORTFOLIO_MAX_ALERTS_PER_DAY=3
# Seller guard: your listing is X% under similar sales.
UNDERPRICE_PCT=15
# "Someone pays more": an open bid nets X% more than listing at fair would.
OFFER_ABOVE_EXIT_PCT=5
# [Alert me if any drops X%] button.
PORTFOLIO_DROP_ALERT_PCT=20

# ===== Paper autopilot and go-live ramp =====
# A paper buy whose item sold within N seconds would have lost the race to a faster bot.
LOST_RACE_SEC=30
# Re-mark paper positions at most every N minutes.
PAPER_MARK_EVERY_MIN=60
# Local hour for the daily paper scoreboard in practice mode (-1 = off).
PAPER_REPORT_HOUR=21
# Recommended paper track record before going live.
PAPER_MIN_DAYS=7
PAPER_MIN_BUYS=3
# true = /dry off is refused until the thresholds above are met.
GOLIVE_REQUIRE_PAPER=false
# The first N hours of live mode only allow X% of the daily budget.
LIVE_RAMP_HOURS=24
LIVE_RAMP_BUDGET_PCT=25

# ===== Explained decisions, event log and digest =====
# Shared suite.event.v1 JSONL log (rotated to .1 at EVENTS_MAX_MB).
EVENTS_FILE=./data/events.jsonl
EVENTS_MAX_MB=20
# Daily digest time (HH:MM, empty = off) and time zone.
DIGEST_AT=21:00
DIGEST_TZ=Europe/Moscow
# Optional: sibling bots' events.jsonl files for a suite section in the digest (comma-separated).
PEER_EVENT_FILES=
# Optional [Explain more] button. Empty = hidden and no network call. The key is never sent in the payload.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Shadow rules and safety envelope =====
# New /autobuy rules start in shadow mode: they record what they would buy and never buy.
SHADOW_NEW_RULES=true
# Hindsight card after SHADOW_MIN_HOURS with SHADOW_MIN_MATCHES matches (or SHADOW_MAX_HOURS with any).
SHADOW_MIN_HOURS=24
SHADOW_MIN_MATCHES=5
SHADOW_MAX_HOURS=168
# A shadow fill whose listing disappears within N seconds counts as sniped (someone else took it).
SNIPED_WINDOW_SEC=120
# Auto-pause after N buy errors in a row, a wallet drop not explained by own buys, or stale data.
AUTO_PAUSE_ERRORS=5
AUTO_PAUSE_BALANCE_DROP_PCT=30
STALE_DATA_SEC=300
# Doctor warns when the hot wallet holds more than X x DAILY_BUDGET_TON.
HOT_WALLET_WARN_X=3
# Live autobuys above this all-in amount (TON) ask for manual confirmation. Empty = half of MAX_PRICE_TON.
CONFIRM_ABOVE=

# ===== Gift floor beacon (cross-market, informational) =====
# This bot's floors, rewritten atomically every cycle (suite.floors.v1).
FLOORS_FILE=./data/floors.json
# Sibling bots' floors files or http(s) URLs (comma-separated). Empty = off.
PEER_FLOORS=
PEER_MAX_AGE_SEC=300
# Skip a buy when another fresh market has the same collection+model this % cheaper all-in.
CROSS_CHEAPER_PCT=3

# ===== Buying (money!) =====
# true = practice only ("PRACTICE · Paper buy ..."), nothing is sent. Default true. This is a hard lock:
# no bot command or stored setting can override it, and it voids an earlier live confirmation.
# Live mode needs DRY_RUN=false AND /dry off in the bot.
DRY_RUN=true
# Autobuy by rules (/autobuy add ...). Can be toggled in the bot with /autobuy on|off.
AUTOBUY_ENABLED=false
# Hard limits on the all-in cost (the bot can only lower them with /set or /preset):
MAX_PRICE_TON=20
DAILY_BUDGET_TON=50
MAX_BUYS_PER_HOUR=2
# Direct buy from the sale contract (without the Getgems API): price + BUY_GAS_TON is sent
# (the contract needs >= +0.1, the excess is returned).
BUY_GAS_TON=0.3
# Max amount above the price that may be sent (check of the Getgems transaction before signing).
BUY_MAX_EXTRA_TON=1.5

# ===== Wallet (only needed for live mode) =====
# 24 words separated by spaces. Never commit! The bot never asks for it in chat.
WALLET_MNEMONIC=
# v4r2 | v5r1
WALLET_VERSION=v4r2
# RPC for sending transactions (@ton/ton TonClient).
TON_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# toncenter key (optional, about 1 rps without it).
TONCENTER_API_KEY=

# ===== Misc =====
DB_PATH=./data/getgems.db
# debug | info | warn | error
LOG_LEVEL=info
